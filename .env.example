# Copy to .env (cp .env.example .env) and change the passwords.
MYSQL_ROOT_PASSWORD=change-my-root-password-to-a-new-one
MYSQL_DATABASE=weather_app
MYSQL_USER=weather_user
MYSQL_PASSWORD=change-my-app-password-to-a-new-one
# Backend
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
WEATHER_CACHE_TTL_SECONDS=600
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=30
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=20
UPSTREAM_RATE_LIMIT=60
TRUST_PROXY=1